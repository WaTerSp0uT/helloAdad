package utils.database;

import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.SQLException;
import java.util.*;

public class DBUtils {

    private DBUtils() {
    }

    public static String getSingleValue(String query, String columnName) {
        ResultSet rs = null;
        try {
            rs = QueryExecutor.executeQuery(query);
            if (rs.next()) {
                return rs.getString(columnName);
            }
            return null;
        } catch (SQLException e) {
            throw new RuntimeException("Failed to fetch single value for query: " + query, e);
        } finally {
            closeResultSet(rs);
        }
    }

    public static boolean recordExists(String query) {
        ResultSet rs = null;
        try {
            rs = QueryExecutor.executeQuery(query);
            return rs.next();
        } catch (SQLException e) {
            throw new RuntimeException("Failed to check record existence for query: " + query, e);
        } finally {
            closeResultSet(rs);
        }
    }

    public static List<Map<String, String>> getQueryResultAsList(String query) {
        ResultSet rs = null;
        List<Map<String, String>> resultList = new ArrayList<>();

        try {
            rs = QueryExecutor.executeQuery(query);
            ResultSetMetaData metaData = rs.getMetaData();
            int columnCount = metaData.getColumnCount();

            while (rs.next()) {
                Map<String, String> rowMap = new LinkedHashMap<>();
                for (int i = 1; i <= columnCount; i++) {
                    rowMap.put(metaData.getColumnLabel(i), rs.getString(i));
                }
                resultList.add(rowMap);
            }

            return resultList;

        } catch (SQLException e) {
            throw new RuntimeException("Failed to fetch query results as list: " + query, e);
        } finally {
            closeResultSet(rs);
        }
    }

    private static void closeResultSet(ResultSet rs) {
        try {
            if (rs != null) {
                if (rs.getStatement() != null) {
                    rs.getStatement().close();
                }
                rs.close();
            }
        } catch (SQLException e) {
            throw new RuntimeException("Failed to close ResultSet", e);
        }
    }
}

