package Hooks;

import Factory.DriverFactory2;
import io.cucumber.java.*;
import org.openqa.selenium.WebDriver;
import utils.ScreenshotUtil;

public class MyHooks {

    private String screenshotMode; // "always" or "failed"

    @Before
    public void setup() {
        // Ensure driver instance created for this thread
        DriverFactory2.getDriver();

        // Read screenshot mode from properties (default to "failed" if missing)
        try {
            String value = Library.getLibrary().getProperty("screenshotOnStep");
            screenshotMode = (value == null || value.isBlank())
                    ? "failed"
                    : value.toLowerCase().trim();
        } catch (Exception e) {
            screenshotMode = "failed";
            System.err.println("Could not read screenshotOnStep property. Defaulting to 'failed'. Reason: " + e.getMessage());
        }
    }

    @AfterStep
    public void afterEachStep(Scenario scenario) {
        try {
            if (shouldTakeStepScreenshot(scenario)) {
                WebDriver driver = DriverFactory2.getDriver();
                byte[] png = ScreenshotUtil.capturePngBytes(driver);
                ScreenshotUtil.attachPng(scenario, png, scenario.getName());
            }
        } catch (Exception e) {
            System.err.println("Error taking step screenshot: " + e.getMessage());
        }
    }

    @After
    public void endAssertionsAndCleanup(Scenario scenario) {
        try {
            // Optional: if you want a final screenshot on failure regardless of step mode:
            // (Helpful if failure happens before AfterStep triggers, or on hooks)
            if (scenario.isFailed() && !"always".equals(screenshotMode)) {
                try {
                    WebDriver driver = DriverFactory2.getDriver();
                    byte[] png = ScreenshotUtil.capturePngBytes(driver);
                    ScreenshotUtil.attachPng(scenario, png, scenario.getName() + "_FINAL");
                } catch (Exception e) {
                    System.err.println("Final failure screenshot failed: " + e.getMessage());
                }
            }

            // IMPORTANT: assertAll should run ALWAYS (not only when scenario failed)
            SoftAssert.assertALL();

        } catch (AssertionError ae) {
            // Let Cucumber mark scenario failed
            throw ae;
        } catch (Exception e) {
            System.err.println("Error during assertions: " + e.getMessage());
        } finally {
            // Ensures driver is closed even if assertion fails
            DriverFactory2.closeDriver();
        }
    }

    private boolean shouldTakeStepScreenshot(Scenario scenario) {
        if ("always".equals(screenshotMode)) return true;
        if ("failed".equals(screenshotMode)) return scenario.isFailed();
        // Unknown value: behave safely (avoid noise)
        return scenario.isFailed();
    }
}


