        // Capture and save expected baseline (permanent)
        byte[] bytes = ScreenshotUtil.captureBytes(driver);
        Path expectedPath = Paths.get(EXPECTED_ROOT, relativeExpectedPath);

        ScreenshotUtil.saveBytesToFile(bytes, expectedPath);

        // Optional: if you want visible console confirmation
        System.out.println("Baseline saved: " + expectedPath);
    }
}
