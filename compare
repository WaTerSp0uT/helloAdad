package stepDefinitions;

import Factory.DriverFactory2;
import io.cucumber.java.en.Then;
import org.openqa.selenium.WebDriver;
import utils.ScreenshotUtil;
import utils.VisualComparisonUtil;

import javax.imageio.ImageIO;
import java.awt.image.BufferedImage;
import java.nio.file.*;

public class VisualCompareSteps {

    private static final String EXPECTED_ROOT = "src/test/resources/visual-baselines";
    private static final String ACTUAL_ROOT   = "target/visual-results/actual";
    private static final String DIFF_ROOT     = "target/visual-results/diff";

    @Then("the page should match baseline {string}")
    public void thePageShouldMatchBaseline(String relativeExpectedPath) throws Exception {
        WebDriver driver = DriverFactory2.getDriver();

        Path expectedPath = Paths.get(EXPECTED_ROOT, relativeExpectedPath);
        if (!Files.exists(expectedPath)) {
            throw new AssertionError("Expected baseline not found: " + expectedPath);
        }

        BufferedImage expected = ImageIO.read(expectedPath.toFile());
        BufferedImage actual = ScreenshotUtil.captureImage(driver);

        // Save actual/diff only under target (run-only)
        String fileName = Paths.get(relativeExpectedPath).getFileName().toString();
        Path actualPath = Paths.get(ACTUAL_ROOT, relativeExpectedPath).getParent().resolve(fileName);
        Path diffPath   = Paths.get(DIFF_ROOT, relativeExpectedPath).getParent().resolve(fileName.replace(".png", "_diff.png"));

        int threshold = Integer.parseInt(System.getProperty("VISUAL_THRESHOLD", "5"));

        VisualComparisonUtil.compareAndFailOnMismatch(expected, actual, actualPath, diffPath, threshold);
    }
}
