SELECT 
    T.TS_TEST_ID        AS [Test ID],
    T.TS_NAME           AS [Test Name],
    CAST(T.TS_DESCRIPTION AS VARCHAR(MAX)) AS [Test Description],
    DS.DS_STEP_NAME     AS [Step Name],
    CAST(DS.DS_DESCRIPTION AS VARCHAR(MAX)) AS [Step Action],
    CAST(DS.DS_EXPECTED AS VARCHAR(MAX))   AS [Expected Result]
FROM TEST T
LEFT JOIN DESSTEPS DS ON T.TS_TEST_ID = DS.DS_TEST_ID
ORDER BY T.TS_TEST_ID, DS.DS_STEP_ORDER;
